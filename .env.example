# Jeeves — example env. Copy to .env (gitignored). This is a DEV convenience only — a
# packaged build has no .env; secrets belong in the OS keychain at runtime (see
# src/main/secrets/keychain.ts) and are set from the app, not from this file.

# WhatsApp connector: live embedded WhatsApp Web (QR). Demo toggle in-app overrides this.
PA_WHATSAPP_MODE=live

# Unified LLM backend for extraction/draft/self-heal (see src/main/llm/complete.ts).
# Order: PA_LLM_BACKEND=claude-code|openai|anthropic|auto (default auto — first one available).
#
# 1. Claude Code — the local `claude` CLI (subscription auth, no API key). Requires
#    `claude login` to have been run once, independently, outside this app.
# PA_LLM_BACKEND=claude-code
# PA_CC_MODEL=claude-haiku-4-5
# PA_CC_MODEL_LARGE=claude-opus-4-8
#
# 2. OpenAI — needs a key. Stored via the in-app secret store; PA_OPENAI_KEY is a dev-only
#    fallback read directly from env.
# PA_OPENAI_KEY=
# PA_OPENAI_MODEL=gpt-4o-mini
# PA_OPENAI_MODEL_LARGE=gpt-4o
#
# 3. Anthropic — needs a key, stored via the in-app secret store (never read from env at
#    runtime; there is no ANTHROPIC_API_KEY env fallback by design — see keychain.ts).
